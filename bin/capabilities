#!/usr/bin/env bash
# Script canônico de gerenciamento e auditoria de Business Capabilities (SDD / DDD)
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SPEC_HUB_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Se FLYWHEEL_DIR não foi fornecido, tenta caminhos padrão
if [ -z "${FLYWHEEL_DIR:-}" ]; then
  if [ -d "${SPEC_HUB_DIR}/../agentic-flywheel/src" ]; then
    FLYWHEEL_DIR="${SPEC_HUB_DIR}/../agentic-flywheel"
  elif [ -d "/home/eduardo/srv/pessoais/agentic-flywheel/src" ]; then
    FLYWHEEL_DIR="/home/eduardo/srv/pessoais/agentic-flywheel"
  elif [ -d "${SPEC_HUB_DIR}/.flywheel_src/src" ]; then
    FLYWHEEL_DIR="${SPEC_HUB_DIR}/.flywheel_src"
  else
    echo "ERRO: Repositório agentic-flywheel não encontrado. Defina FLYWHEEL_DIR." >&2
    exit 1
  fi
fi

export PYTHONPATH="${FLYWHEEL_DIR}/src:${PYTHONPATH:-}"
exec python3 -m flywheel.capabilities "$@" --spec-hub-dir "${SPEC_HUB_DIR}"
